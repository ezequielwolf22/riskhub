    {"id": "Art.21", "name": "Derecho de oposición", "domain": "Derechos", "evidence_types": ["procedure", "record"], "mandatory": true},
    {"id": "Art.22", "name": "Decisiones individuales automatizadas", "domain": "Derechos", "evidence_types": ["procedure", "record"], "mandatory": false},
