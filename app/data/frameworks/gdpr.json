    {"id": "Art.14", "name": "Información al interesado (datos no directos)", "domain": "Derechos", "evidence_types": ["policy_document"], "mandatory": true},
    {"id": "Art.15", "name": "Derecho de acceso", "domain": "Derechos", "evidence_types": ["procedure", "record"], "mandatory": true},
