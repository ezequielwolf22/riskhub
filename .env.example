# RiskHub - Variables de entorno
# Copia este archivo a .env y rellena los valores antes del primer arranque.

# Clave secreta para firmar tokens JWT. Genera una segura con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
RISKHUB_SECRET_KEY=

# Credenciales del primer usuario administrador (se crea al iniciar la BD).
# Cambia la contrasena en cuanto entres por primera vez.
RISKHUB_ADMIN_EMAIL=admin@company.internal
RISKHUB_ADMIN_PASSWORD=

# Puerto en el host donde se publicara la aplicacion.
RISKHUB_PORT_HOST=80

# URL publica de la aplicacion (sin barra final).
# Necesaria para que los emails de reset de contrasena incluyan el enlace correcto.
# Ejemplo: http://192.168.1.100  o  https://riskhub.empresa.com
RISKHUB_PUBLIC_URL=

# Base de datos — por defecto SQLite (no requiere configuracion adicional).
# Para PostgreSQL (recomendado en despliegues con varias replicas o mucha
# escritura concurrente), define RISKHUB_DATABASE_URL y arranca el perfil
# postgres del compose:
#   docker compose --profile postgres up -d
# RISKHUB_DATABASE_URL=postgresql+psycopg2://riskhub:CLAVE@db:5432/riskhub
# POSTGRES_USER=riskhub
# POSTGRES_PASSWORD=pon-una-clave-fuerte
# POSTGRES_DB=riskhub
# Migracion de datos SQLite -> PostgreSQL: scripts/migrate_sqlite_to_postgres.py
# (ver docs/POSTGRES_MIGRATION_PLAN.md).

# Agente IA — Claude API (Anthropic)
# Obtén tu clave en: https://console.anthropic.com/
# Sin esta clave el cuestionario carga pero el análisis no ejecuta.
RISKHUB_ANTHROPIC_API_KEY=

# OSINT — Inteligencia de fuentes abiertas (huella-digital integration)
# Todas estas claves son opcionales. Sin ellas, los escaneos OSINT no ejecutan.

# Have I Been Pwned API
RISKHUB_HIBP_API_KEY=

# VirusTotal API
RISKHUB_VIRUSTOTAL_API_KEY=

# LeakCheck API
RISKHUB_LEAKCHECK_API_KEY=

# Intelligence X API
RISKHUB_INTELX_API_KEY=

# GitHub API Token
RISKHUB_GITHUB_API_TOKEN=
